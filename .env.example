# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Access control (allowlist)
ALLOWED_EMAIL=

# Database (Neon) - `neon env pull`로 채운다
# 앱 쿼리용 (pooled)
DATABASE_URL=
# 마이그레이션용 (direct)
DATABASE_URL_UNPOOLED=

# Claude API (로컬은 `ant auth login` 프로필을 쓰면 비워 둔다. 배포에는 필요)
ANTHROPIC_API_KEY=

# Notion OAuth (hosted Notion MCP). 클라이언트는 앱이 자동 등록한다.
# 로컬: http://localhost:3000/api/notion/callback
NOTION_OAUTH_REDIRECT_URI=

# Token encryption key (32 bytes, base64) - `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
